# ============================================================
# Copia este archivo a `.env` (en la raíz del repositorio) y rellena los valores.
# `.env` NO se versiona. `.env.example` sí: no pongas secretos reales aquí.
# ============================================================

# ===== Frontend (Vite) =====
# Solo las variables con prefijo VITE_ llegan al navegador. No pongas secretos aquí.

# URL del backend (Python FastAPI). OBLIGATORIA.
VITE_API_URL=http://localhost:8000

# Guardar conversaciones en localStorage (false) o en el backend (true)
VITE_REMOTE_CONVERSATIONS=false

# Habilitar la subida de documentos PDF (true/false)
VITE_ENABLE_DOCUMENT_UPLOAD=false

# Motor y versión preseleccionados al abrir la app (opcionales).
# La versión debe existir en la base de datos (V1.0, V1.1, V2.0); vacía = el usuario la elige.
VITE_DEFAULT_ENGINE="ThermoDrive HTM-240"
VITE_DEFAULT_ENGINE_VERSION=V2.0

# ===== Backend (FastAPI) =====
# --- Servidor ---
API_HOST=127.0.0.1
API_PORT=8000
# Orígenes permitidos por CORS, separados por comas (el del frontend)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# --- Rutas y archivos ---
# Base de datos vectorial (ruta relativa a la raíz del repo, o absoluta)
DB_NAME=thermodrive_rag.db
# Conversaciones guardadas por el backend (solo si VITE_REMOTE_CONVERSATIONS=true)
CONVERSATIONS_DB_NAME=conversations.db
# Carpeta de manuales a indexar (relativa a backend/db/, o absoluta)
MANUALS_DIR=manual_htm240

# --- IA ---
# Debe ser el MISMO modelo al generar la BD y al responder (ambos lo leen de aquí)
EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2
# Clave de Groq (SECRETO): https://console.groq.com/keys
GROQ_API_KEY=
LLM_MODEL=openai/gpt-oss-20b
LLM_TEMPERATURE=0.1
# Tokens máximos de la respuesta (incluye el razonamiento interno de gpt-oss)
LLM_MAX_TOKENS=4096
# Esfuerzo de razonamiento de gpt-oss: low | medium | high. Déjalo vacío si cambias a un modelo que no razona
LLM_REASONING_EFFORT=low

# --- RAG (opcionales: estos son los valores por defecto) ---
RAG_TOP_K=5
RAG_DICTIONARY_TOP_K=3
RAG_DICTIONARY_MIN_SCORE=0.3
# Similitud mínima del mejor fragmento para responder, y a partir de cuál la evidencia es "alta"
RAG_EVIDENCE_MIN_SCORE=0.3
RAG_EVIDENCE_HIGH_SCORE=0.5
# Extra de puntuación para fragmentos que contienen el código de avería exacto (HTM-XXXX) de la consulta
RAG_CODE_MATCH_BONUS=0.15
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=200
SOURCE_EXCERPT_CHARS=200
