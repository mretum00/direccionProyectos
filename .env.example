# ===== Frontend (Vite) =====
# Solo las variables con prefijo VITE_ llegan al navegador. No pongas secretos aquí.

# URL del backend (Python FastAPI)
VITE_API_URL=http://localhost:8000

# Usar mock (true) o API real (false)
VITE_USE_MOCK=true

# Guardar conversaciones en localStorage (false) o en backend (true)
VITE_REMOTE_CONVERSATIONS=false

# Habilitar subida de documentos PDF (true/false)
VITE_ENABLE_DOCUMENT_UPLOAD=false

# ===== Backend (FastAPI) =====
# Rutas y archivos
DB_NAME=thermodrive_rag.db
MANUALS_DIR=manual_htm240

# Configuración de IA
EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2

# Configuración del servidor (para FastAPI)
API_PORT=8000
