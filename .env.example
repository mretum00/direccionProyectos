# URL del backend (Python FastAPI)
VITE_API_URL=http://localhost:8000

# Usar mock (true) o API real (false)
VITE_USE_MOCK=true

# Guardar conversaciones en localStorage (false) o en backend (true)
VITE_REMOTE_CONVERSATIONS=false

# Habilitar subida de documentos PDF (true/false)
VITE_ENABLE_DOCUMENT_UPLOAD=false
